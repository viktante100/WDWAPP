@inherits LayoutComponentBase

@inject NavigationManager Navigation

<nav class="site-nav" aria-label="Huvudmeny">
    <div class="nav-inner">
        <details class="menu" @key="Navigation.Uri">
            <summary class="menu-button" aria-label="Öppna meny"><i class="bi bi-list" aria-hidden="true"></i></summary>
            <div class="menu-panel">
                <a href="/nyheter">Nyheter</a>
                <a href="/kalender">Kalender</a>
                <a href="/ligan">40K-ligan</a>
                <a href="/marknad">Marknad</a>
                <a href="/spelare">Spelare</a>
                <AuthorizeView Policy="@AccessLevels.Member"><a href="/sok-match">Sök match</a></AuthorizeView>
                <a href="/om-oss">Om oss</a>
                <AuthorizeView Policy="@AccessLevels.KeyMember">
                    <a href="/hantera" data-enhance-nav="false">Admin / Keymember</a>
                </AuthorizeView>
            </div>
        </details>
        <a href="/" class="nav-logo">
            <img src="/Images/wdw-logo.svg" alt="Wermland Dice Warriors" />
        </a>
        <AuthorizeView>
            <Authorized>
                <a href="/account" class="login-area" data-enhance-nav="false">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span>@context.User.Identity?.Name</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="login-area" data-enhance-nav="false">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span>Ej inloggad</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<main>@Body</main>

<footer class="site-footer">Byggd av Vicke Vire</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <button class="dismiss" aria-label="Stäng felmeddelandet">×</button>
</div>
